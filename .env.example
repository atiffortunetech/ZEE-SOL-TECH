# Hostinger SMTP — sales@zeesoltech.com
# Copy this file to `.env.local` and fill in your real email password from hPanel.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@zeesoltech.com
SMTP_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD
SMTP_FROM=sales@zeesoltech.com
LEAD_TO_EMAIL=sales@zeesoltech.com

# If smtp.hostinger.com fails auth on your plan, try Titan instead:
# SMTP_HOST=smtp.titan.email
