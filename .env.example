# Hostinger SMTP — sales@zeesoltech.com
# Set these in Hostinger → Website → Environment variables (and locally in `.env.local`).
# SMTP_PASS must be the real mailbox password from hPanel → Emails (not a placeholder).

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@zeesoltech.com
SMTP_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD
SMTP_FROM=sales@zeesoltech.com
LEAD_TO_EMAIL=sales@zeesoltech.com

# If you still get "Greeting never received" or auth errors, try Titan + 587:
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=587
# SMTP_SECURE=false
