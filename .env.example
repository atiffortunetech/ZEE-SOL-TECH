# Hostinger mailbox SMTP — sales@zeesoltech.com
# Set these in Hostinger → Website → Environment variables (and locally in `.env.local`).
# SMTP_PASS = the mailbox password from hPanel → Emails (not a placeholder).

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@zeesoltech.com
SMTP_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD
SMTP_FROM=sales@zeesoltech.com
LEAD_TO_EMAIL=sales@zeesoltech.com

# If port 465 fails with "Greeting never received", use Hostinger STARTTLS instead:
# SMTP_PORT=587
# SMTP_SECURE=false

# Google Search Console HTML tag verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token
